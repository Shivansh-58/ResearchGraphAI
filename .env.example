RESEARCHGRAPH_ENV=private
RESEARCHGRAPH_DATA_DIR=./data/private
RESEARCHGRAPH_USERS_FILE=./secrets/users.json
RESEARCHGRAPH_AUTH_REQUIRED=true
RESEARCHGRAPH_EMBEDDING_PROVIDER=ollama
